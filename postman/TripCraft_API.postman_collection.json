{
  "info": {
    "_postman_id": "7f3a0c41-84b7-46fb-b136-1d973d20603d-tripcraft",
    "name": "TripCraft API - Travel Itinerary Planner",
    "description": "Complete Postman collection for TripCraft backend API with all CRUD endpoints, authentication, itineraries, collaborators, budget tracking, search, and weather forecast integration.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "tripId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01. Auth",
      "item": [
        {
          "name": "Register User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.token) {",
                  "    pm.collectionVariables.set('token', json.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alex Traveler\",\n  \"email\": \"alex@tripcraft.dev\",\n  \"password\": \"TripCraft@2026\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "Login User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.token) {",
                  "    pm.collectionVariables.set('token', json.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alex@tripcraft.dev\",\n  \"password\": \"TripCraft@2026\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Get Current User Profile",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "02. Trips",
      "item": [
        {
          "name": "Create New Trip",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data._id) {",
                  "    pm.collectionVariables.set('tripId', json.data._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Grand Tour of Europe\",\n  \"description\": \"A 14-day scenic trip across France, Italy, and Switzerland\",\n  \"destination\": {\n    \"name\": \"Paris\",\n    \"country\": \"France\"\n  },\n  \"startDate\": \"2026-06-15T00:00:00.000Z\",\n  \"endDate\": \"2026-06-29T00:00:00.000Z\",\n  \"budget\": {\n    \"totalBudget\": 4000,\n    \"currency\": \"EUR\"\n  },\n  \"bookings\": [\n    {\n      \"type\": \"hotel\",\n      \"title\": \"Le Grand Hotel Paris\",\n      \"confirmationNumber\": \"PAR-99214\",\n      \"cost\": 650\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/trips",
              "host": ["{{baseUrl}}"],
              "path": ["api", "trips"]
            }
          }
        },
        {
          "name": "Get All User Trips",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/trips",
              "host": ["{{baseUrl}}"],
              "path": ["api", "trips"]
            }
          }
        },
        {
          "name": "Get Trip By ID",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/trips/{{tripId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "trips", "{{tripId}}"]
            }
          }
        },
        {
          "name": "Update Trip",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Updated description: An unforgettable 14-day scenic trip across Europe\",\n  \"status\": \"ongoing\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/trips/{{tripId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "trips", "{{tripId}}"]
            }
          }
        },
        {
          "name": "Delete Trip",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/trips/{{tripId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "trips", "{{tripId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "03. Day-by-Day Itinerary",
      "item": [
        {
          "name": "Add Day Itinerary & Activities",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dayNumber\": 1,\n  \"title\": \"Arrival & Historic Center\",\n  \"date\": \"2026-06-15T00:00:00.000Z\",\n  \"notes\": \"Remember to validate metro tickets\",\n  \"activities\": [\n    {\n      \"time\": \"09:00 AM\",\n      \"activity\": \"Airport Transfer & Check-in\",\n      \"location\": \"Charles de Gaulle Airport to Hotel\",\n      \"cost\": 35\n    },\n    {\n      \"time\": \"02:30 PM\",\n      \"activity\": \"Louvre Museum Tour\",\n      \"location\": \"Rue de Rivoli, 75001 Paris\",\n      \"cost\": 22,\n      \"notes\": \"Mona Lisa and Venus de Milo\"\n    },\n    {\n      \"time\": \"07:30 PM\",\n      \"activity\": \"Dinner at Le Marais\",\n      \"location\": \"Le Marais, Paris\",\n      \"cost\": 60\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/trips/{{tripId}}/itinerary",
              "host": ["{{baseUrl}}"],
              "path": ["api", "trips", "{{tripId}}", "itinerary"]
            }
          }
        },
        {
          "name": "Get Trip Itineraries",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/trips/{{tripId}}/itinerary",
              "host": ["{{baseUrl}}"],
              "path": ["api", "trips", "{{tripId}}", "itinerary"]
            }
          }
        }
      ]
    },
    {
      "name": "04. Collaborators",
      "item": [
        {
          "name": "Share Trip with Collaborator",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"collaborator@tripcraft.dev\",\n  \"role\": \"editor\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/trips/{{tripId}}/share",
              "host": ["{{baseUrl}}"],
              "path": ["api", "trips", "{{tripId}}", "share"]
            }
          }
        }
      ]
    },
    {
      "name": "05. Search",
      "item": [
        {
          "name": "Search Trips by Keyword (e.g. europe)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/trips/search?keyword=europe",
              "host": ["{{baseUrl}}"],
              "path": ["api", "trips", "search"],
              "query": [
                { "key": "keyword", "value": "europe" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "06. Budget & Expenses",
      "item": [
        {
          "name": "Add Expense to Trip",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Louvre Museum Tickets & Audio Guide\",\n  \"amount\": 44,\n  \"category\": \"activities\",\n  \"currency\": \"EUR\",\n  \"notes\": \"Booked online for two people\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/trips/{{tripId}}/expenses",
              "host": ["{{baseUrl}}"],
              "path": ["api", "trips", "{{tripId}}", "expenses"]
            }
          }
        },
        {
          "name": "Get Trip Budget & Expenses Breakdown",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/trips/{{tripId}}/expenses",
              "host": ["{{baseUrl}}"],
              "path": ["api", "trips", "{{tripId}}", "expenses"]
            }
          }
        }
      ]
    },
    {
      "name": "07. Weather Forecast",
      "item": [
        {
          "name": "Get City Weather Forecast",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/weather?city=Paris",
              "host": ["{{baseUrl}}"],
              "path": ["api", "weather"],
              "query": [
                { "key": "city", "value": "Paris" }
              ]
            }
          }
        },
        {
          "name": "Get Trip Destination Weather",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/trips/{{tripId}}/weather",
              "host": ["{{baseUrl}}"],
              "path": ["api", "trips", "{{tripId}}", "weather"]
            }
          }
        }
      ]
    }
  ]
}
