# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String
MONGO_URI=mongodb://127.0.0.1:27017/tripcraft

# JWT Authentication
JWT_SECRET=tripcraft_jwt_secret_key_secure_2026_token
JWT_EXPIRES_IN=7d

# Firebase Configuration (Optional - Local fallback will be used if omitted)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=your-app.appspot.com

# Weather API (Optional - Open-Meteo free API is used automatically as default without key)
WEATHER_API_KEY=
